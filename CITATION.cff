title: "ppofolio: PPO ensemble for multi-asset crypto portfolio allocation"
authors:
  - family-names: Mohammadi
    given-names: Hadi
    orcid: "https://orcid.org/0000-0003-0860-9200"
    affiliation: "Utrecht University"
version: 0.1.0
